<mxfile host="65bd71144e">
    <diagram id="ccx-mesh-inp-flow" name="CalculiX mesh.inp 生成与校验流程">
        <mxGraphModel dx="79540" dy="93240" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1380" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="CalculiX有限元模型自动生成与完整性校验流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="12" width="680" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="mesh.inp 后处理 → job.inp 驱动文件 → CalculiX 求解" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#666666;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="680" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="n0" value="Gmsh 脚本构建&lt;br&gt;标记 Physical Volume（GEAR1 / GEAR2）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="72" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="Gmsh 三维网格划分&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;输出 mesh.inp 初稿&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="132" width="480" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="fail_gmsh" value="&lt;b&gt;异常终止&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;记录日志&lt;br&gt;↓&lt;br&gt;返回失败状态&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#888888;&quot;&gt;mesh.inp 为空&lt;br&gt;Gmsh 划分失败&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#F5F5F5;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#333333;dashed=1;align=center;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="124" width="100" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="网格预处理&lt;br&gt;剥离面单元，保证体单元兼容&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（stripSurfaceElements）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="196" width="480" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="双齿轮体单元集合&lt;br&gt;（GEAR1 / GEAR2）&lt;br&gt;是否存在？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="250" y="272" width="260" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="n_skip" value="跳过丰富化&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（单齿轮 / BEAM 路径）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#F7F7F7;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#000000;dashed=1;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="288" width="100" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="innov_group" value="网格丰富化与集合自动构建（核心模块）" style="swimlane;startSize=32;rounded=1;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;fontColor=#000000;align=center;verticalAlign=top;spacingTop=4;arcSize=12;" vertex="1" parent="1">
                    <mxGeometry x="120" y="384" width="520" height="168" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="网格丰富化&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666;&quot;&gt;（MeshConverter::enrichGearMeshInp）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="innov_group" vertex="1">
                    <mxGeometry x="24" y="44" width="472" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;自动构建有限元集合&lt;/b&gt;&lt;br&gt;• GEAR*_HUB&lt;br&gt;• GEAR*_TOOTH_OUTER&lt;br&gt;• GEAR*_TOOTH_SURF&lt;br&gt;• Master / Slave&lt;br&gt;• GEAR*_HUB_SURF" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#000000;align=center;spacingTop=2;spacingBottom=2;arcSize=12;" parent="innov_group" vertex="1">
                    <mxGeometry x="24" y="100" width="472" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="e34" style="edgeStyle=none;html=1;strokeColor=#82B366;endArrow=classic;strokeWidth=1.2;" parent="innov_group" source="n3" target="n4" edge="1"/>
                <mxCell id="fail_enrich" value="&lt;b&gt;异常终止&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;记录日志&lt;br&gt;↓&lt;br&gt;返回失败状态&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#888888;&quot;&gt;Hub 集合为空&lt;br&gt;Surface 为空&lt;br&gt;齿面节点为空&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#F5F5F5;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#333333;dashed=1;align=center;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="420" width="100" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="网格统计&lt;br&gt;记录节点数、单元数&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（recordMeshStatsOnDesignPoint）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="572" width="480" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="完整性校验&lt;br&gt;检查 HUB、接触面、边界集合&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（runInpWriteStep）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="648" width="480" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="边界与接触集合&lt;br&gt;是否完整？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="250" y="724" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="fail_inp" value="&lt;b&gt;异常终止&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;记录日志&lt;br&gt;↓&lt;br&gt;返回失败状态&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#888888;&quot;&gt;Hub 集合为空&lt;br&gt;HUB_SURF 缺失&lt;br&gt;边界集合不完整&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#F5F5F5;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#333333;dashed=1;align=center;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="712" width="100" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="输入文件生成&lt;br&gt;生成 job.inp，引用 mesh.inp&lt;br&gt;写入材料、边界、接触、载荷&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（writeJobInp / CCXInpWriter）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="824" width="480" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="输入文件审计&lt;br&gt;↓ 集合统计&lt;br&gt;↓ 法向检查&lt;br&gt;↓ 日志输出&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（CCXInpWriter）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#F7F7F7;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#000000;dashed=1;align=center;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="908" width="480" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="CalculiX 自动求解&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888888;&quot;&gt;（runSolveStep）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;fontStyle=1;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="140" y="1000" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="调用 CCX 求解器&lt;br&gt;生成 DAT / FRD 结果文件" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#000000;arcSize=12;" vertex="1" parent="1">
                    <mxGeometry x="140" y="1064" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="流程控制：任一步骤校验失败时，系统异常终止、记录日志并返回失败状态，不进入后续求解环节。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#666666;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1128" width="680" height="28" as="geometry"/>
                </mxCell>
