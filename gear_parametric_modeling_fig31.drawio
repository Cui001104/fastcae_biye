<mxfile host="65bd71144e">
    <diagram id="fig31-parametric-modeling" name="图3-1 参数化建模模块工作流程">
        <mxGraphModel dx="1087" dy="756" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="819" pageHeight="1160" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="图 3-1  基于OpenCASCADE的齿轮参数化建模流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontFamily=SimSun;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="160" y="20" width="500" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="outer" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FAFAFA;strokeWidth=1.2;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="84" width="740" height="1020" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="&lt;b&gt;① 齿轮设计参数输入&lt;/b&gt;&lt;br&gt;m, Z₁, Z₂, α, x₁, x₂, hₐ*, h*f, ρ*, B₁/B₂, Cₐ, Lₐ, 齿轮类型" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="104" width="580" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="&lt;b&gt;② 参数合法性校验&lt;/b&gt;&lt;br&gt;Z ≥ 3 · m &gt; 0 · 齿宽 B &gt; 0 · |x| 防齿顶变尖提示" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFF8E1;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="281" y="192" width="259" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s2_fail" value="提示错误，&lt;br&gt;终止建模" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFEBEE;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="1" vertex="1">
                    <mxGeometry x="580" y="204" width="120" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="&lt;b&gt;③ 啮合几何参数计算&lt;/b&gt;&lt;br&gt;标准中心距 a = m(Z₁+Z₂)/2&lt;br&gt;变位时牛顿迭代求工作啮合角 α′，得变位中心距 a′ = a·cosα/cosα′&lt;br&gt;计算基圆 Rb、齿顶圆 Ra、齿根圆 Rf 及齿厚半角" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F7F7F7;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="296" width="580" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s4_group" value="④ 二维渐开线齿廓生成" style="swimlane;startSize=28;rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;fontStyle=1;fontColor=#000000;align=center;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="100" y="400" width="620" height="248" as="geometry"/>
                </mxCell>
                <mxCell id="s4a" value="渐开线参数化采样&lt;br&gt;θ ∈ [θf, θa]，每齿段 50 点" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="24" y="48" width="160" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s4b" value="齿顶抛物线修型&lt;br&gt;Δr = Ca·(y/Lca)²" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="204" y="48" width="140" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s4c" value="单齿轮廓拼接&lt;br&gt;左/右渐开线 + 齿顶弧 + 齿根弧" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="364" y="48" width="160" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s4d" value="周向阵列 Z 齿&lt;br&gt;→ 二维齿轮轮廓" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="544" y="48" width="72" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s4e" value="主动轮轮廓&amp;nbsp;&lt;br&gt;（原点放置）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#E3F2FD;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="80" y="148" width="200" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="s4f" value="从动轮轮廓&lt;br&gt;（平移至 (0, a′, 0)）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#E3F2FD;fontFamily=SimSun;fontSize=11;fontColor=#000000;align=center;" parent="s4_group" vertex="1">
                    <mxGeometry x="340" y="148" width="200" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="e4ab" style="edgeStyle=none;html=1;strokeColor=#000000;endArrow=classic;strokeWidth=1;" parent="s4_group" source="s4a" target="s4b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4bc" style="edgeStyle=none;html=1;strokeColor=#000000;endArrow=classic;strokeWidth=1;" parent="s4_group" source="s4b" target="s4c" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4cd" style="edgeStyle=none;html=1;strokeColor=#000000;endArrow=classic;strokeWidth=1;" parent="s4_group" source="s4c" target="s4d" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4_down1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=classic;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="s4_group" source="s4d" target="s4e" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="574" y="120"/>
                            <mxPoint x="180" y="120"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4_down2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=classic;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="s4_group" source="s4d" target="s4f" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="574" y="120"/>
                            <mxPoint x="440" y="120"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s5" value="&lt;b&gt;⑤ 三维实体拉伸生成&lt;/b&gt;&lt;br&gt;中心孔 （d = 0.4×分度圆直径）+ 外轮廓 闭环&lt;br&gt;分别按齿宽 B₁、B₂ 生成双齿轮独立实体（不做布尔合并）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="680" width="580" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s6" value="&lt;b&gt;⑥ 啮合相位调整&lt;/b&gt;&lt;br&gt;从动轮绕自身轴线旋转：半齿距补偿 + [inv(α′) − inv(α)]&lt;br&gt;保证变位齿轮对在啮合线上正确对齿/对槽" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F7F7F7;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="792" width="580" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s7" value="&lt;b&gt;⑦ 面语义自动标注&lt;/b&gt;&lt;br&gt;按径向距离与端面法向分类&lt;br&gt;为后续网格集合识别与边界条件施加提供几何语义" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="888" width="580" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s8" value="&lt;b&gt;⑧ 几何数据注册与可视化输出&lt;/b&gt;&lt;br&gt;写入几何树 · 视口三维预览 · 支持 BREP/STEP 导出" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#E8F5E9;fontFamily=SimSun;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" parent="1" vertex="1">
                    <mxGeometry x="120" y="984" width="580" height="64" as="geometry"/>
                </mxCell>
