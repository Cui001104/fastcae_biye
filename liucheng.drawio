                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;flowchart TB\n\n%% 图题\nTitle[\&quot;图2-X 齿轮CAD/CAE智能优化一体化平台总体架构图\&quot;]\n\n%% ================= 用户交互层 =================\nsubgraph L1[\&quot;用户交互层\&quot;]\n    direction LR\n    A1[\&quot;参数输入\&quot;]\n    A2[\&quot;工况设置\&quot;]\n    A3[\&quot;优化配置\&quot;]\n    A4[\&quot;结果显示\&quot;]\nend\n\n%% ============== CAD/CAE自动分析层 ==============\nsubgraph L2[\&quot;CAD/CAE自动分析层\&quot;]\n    direction LR\n    B1[\&quot;参数化建模模块&lt;br/&gt;Open CASCADE\&quot;]\n    B2[\&quot;自动网格划分模块&lt;br/&gt;Gmsh\&quot;]\n    B3[\&quot;有限元求解模块&lt;br/&gt;CalculiX\&quot;]\n    B4[\&quot;结果解析模块&lt;br/&gt;FRD / DAT\&quot;]\n    B5[\&quot;有限元验证\&quot;]\nend\n\n%% ============== 数据与智能优化层 ==============\nsubgraph L3[\&quot;数据与智能优化层\&quot;]\n    direction LR\n    C2[\&quot;历史样本管理\&quot;]\n    C1[(\&quot;SQLite数据库\&quot;)]\n    C3[\&quot;RBF代理模型\&quot;]\n    C4[\&quot;NSGA-II多目标优化\&quot;]\n    C5[\&quot;Pareto解集输出\&quot;]\n    C6[\&quot;候选设计方案\&quot;]\nend\n\n%% ================= 主流程 =================\nTitle --&gt; A1\n\nA1 --&gt; B1\nA2 --&gt; B1\nA3 --&gt; C4\n\nB1 --&gt; B2\nB2 --&gt; B3\nB3 --&gt; B4\nB4 --&gt; C1\n\nC1 --&gt; C2\nC2 --&gt; C3\nC1 --&gt; C3\nC3 --&gt; C4\nC4 --&gt; C6\nC6 --&gt; B5\nB5 --&gt; B3\nB5 --&gt; C1\n\nC4 --&gt; C5\nC5 --&gt; A4\nB4 --&gt; A4\nC1 --&gt; A4\n\n%% ================= 数据库中心连接 =================\nC1 -.-&gt; B4\nC1 -.-&gt; C4\nC1 -.-&gt; B5\n\n%% ================= 样式设置：黑白/浅色学术风格 =================\nclassDef title fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000,font-family:SimSun,Microsoft YaHei,font-size:16px;\nclassDef layer fill:#f7f7f7,stroke:#000000,stroke-width:1.2px,color:#000000,font-family:SimSun,Microsoft YaHei;\nclassDef module fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000,font-family:SimSun,Microsoft YaHei;\nclassDef database fill:#eeeeee,stroke:#000000,stroke-width:1.5px,color:#000000,font-family:SimSun,Microsoft YaHei;\n\nclass Title title;\nclass A1,A2,A3,A4,B1,B2,B3,B4,B5,C2,C3,C4,C5,C6 module;\nclass C1 database;\n```&quot;,&#10;  &quot;config&quot;: {&#10;    &quot;theme&quot;: &quot;neutral&quot;,&#10;    &quot;arrowMarkerAbsolute&quot;: false,&#10;    &quot;flowchart&quot;: {&#10;      &quot;htmlLabels&quot;: false&#10;    },&#10;    &quot;sequence&quot;: {&#10;      &quot;diagramMarginX&quot;: 50,&#10;      &quot;diagramMarginY&quot;: 10,&#10;      &quot;actorMargin&quot;: 50,&#10;      &quot;width&quot;: 150,&#10;      &quot;height&quot;: 65,&#10;      &quot;boxMargin&quot;: 10,&#10;      &quot;boxTextMargin&quot;: 5,&#10;      &quot;noteMargin&quot;: 10,&#10;      &quot;messageMargin&quot;: 35,&#10;      &quot;mirrorActors&quot;: true,&#10;      &quot;bottomMarginAdj&quot;: 1,&#10;      &quot;useMaxWidth&quot;: true,&#10;      &quot;rightAngles&quot;: false,&#10;      &quot;showSequenceNumbers&quot;: false&#10;    },&#10;    &quot;gantt&quot;: {&#10;      &quot;titleTopMargin&quot;: 25,&#10;      &quot;barHeight&quot;: 20,&#10;      &quot;barGap&quot;: 4,&#10;      &quot;topPadding&quot;: 50,&#10;      &quot;leftPadding&quot;: 75,&#10;      &quot;gridLineStartPadding&quot;: 35,&#10;      &quot;fontSize&quot;: 11,&#10;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#10;      &quot;numberSectionStyles&quot;: 4,&#10;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;&#10;    }&#10;  }&#10;}" id="2">
